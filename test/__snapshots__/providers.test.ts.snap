exports[`preserva os comandos nativos de cursor 1`] = `
[
  {
    "command": {
      "args": [
        "-p",
        "--force",
        "--approve-mcps",
        "--trust",
        "--allowed-tools",
        "read_tool_call,glob_tool_call,grep_tool_call,ls_tool_call,sem_search_tool_call,read_lints_tool_call,read_todos_tool_call,update_todos_tool_call,mcp_tool_call,get_mcp_tools_tool_call,list_mcp_resources_tool_call,read_mcp_resource_tool_call",
      ],
      "command": "cursor-agent",
      "format": "text",
      "projectMcp": {
        "entry": {
          "args": [
            "bridge.js",
          ],
          "command": "node",
        },
        "file": ".cursor/mcp.json",
      },
      "stdin": "Pedido fixo
com espaço",
    },
    "permission": "board",
    "structured": false,
    "withDirs": false,
    "withExec": false,
  },
  {
