# ============================================================================
# Chaves para a investigação de modos de execução (CLI / ACP / API).
# Para usar: copie para `.env` (cp .env.example .env) e preencha LOCALMENTE.
# O `.env` está no .gitignore — nunca commitar nem colar em chat/issue/PR.
# ============================================================================

# --- Fase 3 (API) -----------------------------------------------------------

# Anthropic (Claude) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI (Codex) — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Moonshot (Kimi) — https://platform.moonshot.ai/console/api-keys
MOONSHOT_API_KEY=

# Google (Gemini; modelos do Antigravity) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Fases 1 e 2 (CLI e ACP) -------------------------------------------------
# O login interativo de cada CLI já cobre a maioria. As chaves abaixo são
# alternativas headless (úteis para ACP sem login na máquina):

# Cursor — usada por `agent acp` sem `agent login` prévio
CURSOR_API_KEY=

# Kimi — se preferir chave em vez de `kimi login`
KIMI_API_KEY=
