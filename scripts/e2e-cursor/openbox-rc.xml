<?xml version="1.0" encoding="UTF-8"?>
<!-- Modo noVNC do teste e2e: a tela virtual só tem o Cursor, então toda janela abre maximizada. -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <applications>
    <application class="*" type="normal">
      <maximized>yes</maximized>
    </application>
  </applications>
</openbox_config>
