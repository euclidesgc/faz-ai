{
  "name": "faz-ai",
  "displayName": "Faz AI Kanban",
  "description": "Board kanban para Spec-Driven Development com IA, dentro do editor: histórias, sub-tarefas e um servidor MCP para a IA ler e atualizar o board",
  "version": "0.27.0",
  "publisher": "euclidesgc",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/euclidesgc/faz-ai.git"
  },
  "bugs": {
    "url": "https://github.com/euclidesgc/faz-ai/issues"
  },
  "homepage": "https://github.com/euclidesgc/faz-ai#readme",
  "keywords": [
    "kanban",
    "board",
    "sdd",
    "spec-driven development",
    "mcp",
    "ai",
    "claude",
    "cursor",
    "codex",
    "kimi",
    "copilot"
  ],
  "galleryBanner": {
    "color": "#1e1b4b",
    "theme": "dark"
  },
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "AI"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "fazai.openBoard",
        "title": "Faz AI: Abrir Board",
        "icon": "$(project)"
      },
      {
        "command": "fazai.refreshSidebar",
        "title": "Faz AI: Atualizar",
        "icon": "$(refresh)"
      },
      {
        "command": "fazai.openCard",
        "title": "Faz AI: Abrir Card"
      },
      {
        "command": "fazai.connectAI",
        "title": "Faz AI: Conectar IA (MCP)",
        "icon": "$(plug)"
      },
      {
        "command": "fazai.upgradeBoard",
        "title": "Faz AI: Atualizar board para o padrão atual"
      },
      {
        "command": "fazai.heartbeat.runNow",
        "title": "Faz AI: Rodar o heartbeat agora (tratar pendências com a IA)"
      },
      {
        "command": "fazai.heartbeat.stop",
        "title": "Faz AI: Parar as execuções da IA"
      },
      {
        "command": "fazai.showLog",
        "title": "Faz AI: Mostrar o log das execuções"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "fazai",
          "title": "Faz AI",
          "icon": "media/kanban.svg"
        }
      ]
    },
    "views": {
      "fazai": [
        {
          "id": "fazai.sidebar",
          "name": "Board",
          "icon": "media/kanban.svg"
        },
        {
          "id": "fazai.filters",
          "name": "Filtros",
          "type": "webview",
          "icon": "media/kanban.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "fazai.sidebar",
        "contents": "Abra uma pasta para usar o board.\n[Abrir pasta](command:vscode.openFolder)",
        "when": "workbenchState == empty"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "fazai.openCard",
          "when": "false"
        },
        {
          "command": "fazai.refreshSidebar",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "fazai.openBoard",
          "when": "view == fazai.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "fazai.refreshSidebar",
          "when": "view == fazai.sidebar",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "build": "npm run build:ext && npm run build:web",
    "build:ext": "node esbuild.mjs",
    "build:web": "vite build",
    "watch:ext": "node esbuild.mjs --watch",
    "watch:web": "vite build --watch",
    "typecheck": "tsc -p tsconfig.extension.json --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "test": "npm run build:ext && vitest run",
    "package": "vsce package",
    "vscode:prepublish": "npm run build",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.9",
    "@types/vscode": "^1.90.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.23.0",
    "marked": "^13.0.2",
    "ovsx": "^1.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.11.0",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vitest": "^2.0.3",
    "zod": "^4.6.5",
    "zustand": "^4.5.4"
  }
}
